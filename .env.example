# Local development placeholders. Copy to .env for host-side tools.
# Do not put production credentials in this file. .env is gitignored.
# These defaults are intentionally local-only; set unique externally managed
# credentials before using any non-loopback deployment profile.
# Docker Compose services use container DNS names and do not read DATABASE_URL
# or KAFKA_BOOTSTRAP_SERVERS from this file.

POSTGRES_USER=titan
POSTGRES_PASSWORD=titan_dev_password
POSTGRES_DB=titan
POSTGRES_HOST_PORT=5435

# Host tools (uv, Alembic, the event generator, verification scripts).
# Keep the port aligned with POSTGRES_HOST_PORT. Containers use postgres:5432.
DATABASE_URL=postgresql+psycopg://titan:titan_dev_password@localhost:5435/titan
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Containers use kafka:19092. Do not point a container at localhost:9092.

CLICKHOUSE_USER=titan
CLICKHOUSE_PASSWORD=titan_dev_password
CLICKHOUSE_DB=titan
CLICKHOUSE_HTTP_URL=http://localhost:8123

MINIO_ROOT_USER=titan
MINIO_ROOT_PASSWORD=titan_dev_password
MINIO_ENDPOINT=localhost:9000

CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# Required for replay and CSV resume. An empty value rejects those admin calls.
# This is a local placeholder, not a credential for a public deployment.
# REST event publication and CSV upload stay open on the published local ports.
TITAN_ADMIN_TOKEN=
# Required for protected API reads/writes; leave unset only for a deliberately
# closed local API. The dashboard proxy reads these server-side.
TITAN_READ_TOKEN=
TITAN_WRITE_TOKEN=

# Optional observability profile. Leave tracing off unless the collector is running.
# Grafana uses the same local password placeholder as the databases.
# GRAFANA_ADMIN_PASSWORD=titan_dev_password
# OTEL_ENABLED=0
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
