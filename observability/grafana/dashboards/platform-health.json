{
  "uid": "titan-platform",
  "title": "Platform health",
  "tags": ["titan"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Scrape targets",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "none", "min": 0, "max": 1, "decimals": 0 } },
      "targets": [{ "refId": "A", "expr": "up", "legendFormat": "{{job}}" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "API ready",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "titan_api_ready" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Metrics refresh ok",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 0 } },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "refId": "A", "expr": "titan_metrics_refresh_ok" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Postgres connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_stat_database_numbackends{datname=\"titan\"}",
          "legendFormat": "backends"
        }
      ]
    }
  ]
}
