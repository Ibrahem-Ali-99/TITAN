# Isolated checkout. Copy to .env only in a directory started with
# COMPOSE_PROJECT_NAME=titan-clone and docker-compose.clone.yml.
# These are the same local placeholders as .env.example, on other host ports.
# Do not point this file at the development ports.

COMPOSE_PROJECT_NAME=titan-clone
COMPOSE_FILE=docker-compose.yml;docker-compose.clone.yml

POSTGRES_USER=titan
POSTGRES_PASSWORD=titan_dev_password
POSTGRES_DB=titan
POSTGRES_HOST_PORT=25435

DATABASE_URL=postgresql+psycopg://titan:titan_dev_password@127.0.0.1:25435/titan
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

CLICKHOUSE_USER=titan
CLICKHOUSE_PASSWORD=titan_dev_password
CLICKHOUSE_DB=titan
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=28123
CLICKHOUSE_DATABASE=titan
CLICKHOUSE_HTTP_URL=http://localhost:28123

MINIO_ROOT_USER=titan
MINIO_ROOT_PASSWORD=titan_dev_password
MINIO_ENDPOINT=localhost:29000
S3_ENDPOINT=http://localhost:29000
S3_ACCESS_KEY=titan
S3_SECRET_KEY=titan_dev_password

API_BASE_URL=http://localhost:28000
CORS_ORIGINS=http://localhost:23000
LOG_LEVEL=INFO

# Local placeholder for replay and CSV resume. Not a public credential.
TITAN_ADMIN_TOKEN=

PYTHONPATH=pipelines/warehouse/src;pipelines/quality/src;pipelines/ml/src;pipelines/dagster/src
